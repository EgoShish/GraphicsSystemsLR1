<Window x:Class="WPF2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WPF2.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="АксиОМА Контрол"
        MinWidth="1200" MinHeight="800"
        Width="1450" Height="1015"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <!-- Регистрируем конвертер под ключом "PathToImageConverter" -->
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Голубая кнопка (наследуется от базового) -->
        <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A9C9FF"/>
        </Style>

        <!-- Зелёная кнопка осей -->
        <Style x:Key="AxisButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0FFC0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="3">
        <!-- Определяем сетку: 3 колонки, несколько строк -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Шапка -->
            <RowDefinition Height="*"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>

        <!-- 1. ШАПКА (Заголовок) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
            Margin="3" CornerRadius="5"
            Background="White" BorderBrush="#DADADA" BorderThickness="1">
            <Label Content="{Binding HeaderText}"
               FontSize="22" FontWeight="SemiBold"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>
        </Border>

        <!-- 2. ЛЕВАЯ ПАНЕЛЬ (Выбор станка + Картинка) -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <!-- Картинка займет всё оставшееся место -->
            </Grid.RowDefinitions>

            <!-- Тип станка -->
            <Label Grid.Row="0" Content="Тип станка:" Margin="3,3,3,0"/>
            <ComboBox Grid.Row="1" Margin="3" Height="30"
                  ItemsSource="{Binding MachineTypes}"
                  SelectedItem="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="FullName"/>

            <!-- Наименование -->
            <Label Grid.Row="2" Content="Наименование:" Margin="3,3,3,0"/>
            <ComboBox Grid.Row="3" Margin="3" Height="30"
                  ItemsSource="{Binding MachineModels}"
                  SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="FullName"/>

            <!-- Картинка (пока пустая заглушка, конвертер добавим на следующем шаге) -->
            <Border Grid.Row="4" Margin="3" 
                BorderThickness="2" BorderBrush="#A0A0A0" 
                Background="White" MinHeight="100">
                <Image Source="{Binding SelectedModel.ImageName, 
                    Converter={StaticResource PathToImageConverter}}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="3" 
        Background="White" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="4">

            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="Auto" MinHeight="45"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- ==================== ГРАФИК 1: ЛИНЕЙНЫЙ ==================== -->

                <Label Grid.Row="0" 
               Content="📈 График прогрева шпинделя" 
               FontWeight="SemiBold" FontSize="14"
               VerticalContentAlignment="Center"
               Margin="3,0,3,3"/>

                <Grid Grid.Row="1" Margin="3,0,3,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Margin="3" Height="30"
                      ItemsSource="{Binding UniqueDates}"
                      SelectedItem="{Binding SelectedDate}"
                      DisplayMemberPath="DateDisplay"
                      Style="{StaticResource {x:Type ComboBox}}"/>

                    <ComboBox Grid.Column="1" Margin="3" Height="30"
                      ItemsSource="{Binding AvailableTimeFrom}"
                      SelectedItem="{Binding SelectedTimeFrom}"
                      DisplayMemberPath="FullDisplay"/>

                    <ComboBox Grid.Column="2" Margin="3" Height="30"
                      ItemsSource="{Binding AvailableTimeTo}"
                      SelectedItem="{Binding SelectedTimeTo}"
                      DisplayMemberPath="FullDisplay"/>

                    <Button Grid.Column="3" Margin="3" Height="30" Padding="15,0"
                    Content="Вывод" Style="{StaticResource BlueButtonStyle}"
                    Command="{Binding LoadLineChartCommand}"/>
                </Grid>

                <Border Grid.Row="2" Margin="3" 
                    BorderBrush="#E0E0E0" BorderThickness="1" 
                    Background="#FAFAFA" CornerRadius="4">
                    <lvc:CartesianChart 
                        Series="{Binding TemperatureSeries}"
                        XAxes="{Binding XAxis}"
                        YAxes="{Binding YAxis}"
                        ZoomMode="X"
                        TooltipPosition="Bottom">
                    </lvc:CartesianChart>
                </Border>

                <!-- ==================== ГРАФИК 2: СТОЛБЧАТЫЙ ==================== -->

                <Border Grid.Row="4" Margin="3" 
        BorderBrush="#E0E0E0" BorderThickness="1" 
        Background="#FAFAFA" CornerRadius="4">

                    <lvc:CartesianChart 
        Series="{Binding ColumnChartSeries}"
        XAxes="{Binding ColumnXAxis}"
        YAxes="{Binding ColumnYAxis}"
        ZoomMode="X"
        TooltipPosition="Bottom"
        LegendPosition="Hidden"  <!-- Легенда не нужна, цвета интуитивны -->
                        Margin="5">

                        <!-- 🔥 Кастомный тултип для столбцов -->
                        <lvc:CartesianChart.Tooltip>
                            <lvc:DefaultTooltip 
                Background="White"
                TextSize="11"
                CornerRadius="4"
                Padding="10,8">

                                <!-- Форматирование текста тултипа -->
                                <lvc:DefaultTooltip.LabelBuilder>
                                    <Func x:TypeArguments="lvc:ChartPoint, IEnumerable">
                                        <![CDATA[
                                        (point) => 
                            {
                                if (point.Context.DataSource is WpfApp1.Models.ColumnChartData data)
                                {
                                    return new[] 
                                    { 
                                        $"Время: {data.Timestamp:HH:mm}",
                                        $"Температура: {data.Temperature:F1}°C",
                                        $"Длительность: {data.DurationMinutes:F1} мин"
                                    };
                                }
                                return new[] { point.PrimaryValue.ToString() };
                            }
                        ]]>
                                    </Func>
                                </lvc:DefaultTooltip.LabelBuilder>
                            </lvc:DefaultTooltip>
                        </lvc:CartesianChart.Tooltip>
                    </lvc:CartesianChart>
                </Border>
        </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Margin="3" Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Text="Панель справа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
