<Window x:Class="WPF2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WPF2.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="АксиОМА Контрол"
        MinWidth="1200" MinHeight="800"
        Width="1450" Height="1015"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A9C9FF"/>
        </Style>

        <Style x:Key="AxisButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0FFC0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2,1,2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <!-- Основной grid - разметка всей формы -->
    <Grid Margin="3">
      
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="250"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                Margin="3" CornerRadius="5"
                Background="White" BorderBrush="#C0C0C0" BorderThickness="1">
            <Label Content="{Binding HeaderText}"
                   FontSize="22" FontWeight="SemiBold"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
        </Border>

        <!-- Левая панель -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="3"
                Background="#F8F8F8" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Тип станка:" Margin="2"/>
                <ComboBox Grid.Row="1" Margin="2" Height="28"
                          ItemsSource="{Binding MachineTypes}"
                          SelectedItem="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="FullName"/>

                <Label Grid.Row="2" Content="Наименование:" Margin="2"/>
                <ComboBox Grid.Row="3" Margin="2" Height="28"
                          ItemsSource="{Binding MachineModels}"
                          SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="FullName"/>

                <Border Grid.Row="4" Margin="2" 
                        BorderThickness="1" BorderBrush="#B0B0B0" 
                        Background="White" MinHeight="100" CornerRadius="3">
                    <Image Source="{Binding SelectedModel.ImageName, Converter={StaticResource PathToImageConverter}}"
                           Stretch="Uniform" Margin="2"/>
                </Border>
            </Grid>
        </Border>

        <!-- Центральная панель -->
        <Border Grid.Row="1" Grid.Column="1" Margin="3" 
                Background="#F8F8F8" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="Auto" MinHeight="40"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="📈 Прогрев шпинделя" 
                       FontWeight="SemiBold" FontSize="13" Margin="2"/>

                <Grid Grid.Row="1" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Margin="2" Height="28"
                              ItemsSource="{Binding UniqueDates}"
                              SelectedItem="{Binding SelectedDate}"
                              DisplayMemberPath="DateDisplay"/>
                    <ComboBox Grid.Column="1" Margin="2" Height="28"
                              ItemsSource="{Binding AvailableTimeFrom}"
                              SelectedItem="{Binding SelectedTimeFrom}"
                              DisplayMemberPath="FullDisplay"/>
                    <ComboBox Grid.Column="2" Margin="2" Height="28"
                              ItemsSource="{Binding AvailableTimeTo}"
                              SelectedItem="{Binding SelectedTimeTo}"
                              DisplayMemberPath="FullDisplay"/>
                    <Button Grid.Column="3" Margin="2" Height="28" Padding="10,0"
                            Content="Вывод" Style="{StaticResource BlueButtonStyle}"
                            Command="{Binding LoadLineChartCommand}"/>
                </Grid>

                <!-- График 1: График прогрева шпинделя -->
                <Border Grid.Row="2" Margin="2" 
                        BorderBrush="#D0D0D0" BorderThickness="1" 
                        Background="White" CornerRadius="3">
                    <lvc:CartesianChart 
                        Series="{Binding LineChartSeries}"
                        XAxes="{Binding LineXAxis}"
                        YAxes="{Binding LineYAxis}"
                        ZoomMode="X"
                        TooltipPosition="Bottom"
                        Margin="3"/>
                </Border>

                <Grid Grid.Row="3" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="📊 Температура" 
                           FontWeight="SemiBold" FontSize="13" Margin="2"/>
                    <Button Grid.Column="1" Margin="2" Height="28" Padding="10,0"
                            Content="Вывод" Style="{StaticResource BlueButtonStyle}"
                            Command="{Binding LoadColumnChartCommand}"/>
                </Grid>

                <!-- График 2: График температур -->
                <Border Grid.Row="4" Margin="2" 
                        BorderBrush="#D0D0D0" BorderThickness="1" 
                        Background="White" CornerRadius="3">
                    <lvc:CartesianChart 
                        Series="{Binding ColumnChartSeries}"
                        XAxes="{Binding ColumnXAxis}"
                        YAxes="{Binding ColumnYAxis}"
                        ZoomMode="X"
                        TooltipPosition="Bottom"
                        Margin="3"/>
                </Border>
            </Grid>
        </Border>

        <!-- Правая панель -->
        <Border Grid.Row="1" Grid.Column="2" Margin="3"
                Background="#F8F8F8" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="Auto" MinHeight="50"/>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="⚙️ Текущие значения компонентов" 
                       FontWeight="SemiBold" FontSize="13" Margin="2"/>

                <Grid Grid.Row="1" Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="1">
                        <Button Content="Шпиндель" Style="{StaticResource BlueButtonStyle}"/>
                        <Button Content="Ось X" Style="{StaticResource BlueButtonStyle}"/>
                        <Button Content="Ось Y" Style="{StaticResource BlueButtonStyle}"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="1">
                        <Button Content="Ось Z" Style="{StaticResource BlueButtonStyle}"/>
                        <Button Content="Панель оператора" Style="{StaticResource BlueButtonStyle}"/>
                        <Button Content="СЧПУ" Style="{StaticResource BlueButtonStyle}"/>
                    </UniformGrid>
                </Grid>

                <Label Grid.Row="2" Content="📋 Активные сообщения" 
                       FontWeight="SemiBold" FontSize="13" Margin="2"/>

                <!-- Таблица активных сообщений -->
                <Border Grid.Row="3" Margin="2" 
                        BorderBrush="#D0D0D0" BorderThickness="1" 
                        Background="White" CornerRadius="3">
                    <DataGrid ItemsSource="{Binding MachineMessages}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Margin="2"
                              RowHeight="25"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="40"/>
                            <DataGridTextColumn Header="Компонент" Binding="{Binding DataName}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="70"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E8F4FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
