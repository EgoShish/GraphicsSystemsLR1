<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WpfApp1.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="АксиОМА Контрол"
        MinWidth="1200" MinHeight="800"
        Width="1450" Height="1015"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <converters:PathToImageConverter x:Key="PathToImageConverter"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A9C9FF"/>
        </Style>

        <Style x:Key="AxisButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0FFC0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationMenuButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MainMenu"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="MenuButtonBorder"
                                Background="White"
                                BorderBrush="#DADADA"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="#A9C9FF"/>
                                <Setter TargetName="MenuButtonBorder" Property="BorderBrush" Value="#7EB4EA"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*" MinWidth="280"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
            <ColumnDefinition Width="4*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
            Margin="3" CornerRadius="5"
            Background="White" BorderBrush="#DADADA" BorderThickness="1">
            <Label Content="{Binding HeaderText}"
               FontSize="22" FontWeight="SemiBold"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <RadioButton Content="Главная" 
                             Style="{StaticResource NavigationMenuButtonStyle}"
                             IsChecked="{Binding IsHomeSelected}"/>
                <RadioButton Content="Мониторинг" 
                             Style="{StaticResource NavigationMenuButtonStyle}"
                             IsChecked="{Binding IsMonitoringSelected}"/>
                <RadioButton Content="Анализ" 
                             Style="{StaticResource NavigationMenuButtonStyle}"
                             IsChecked="{Binding IsAnalysisSelected}"/>
                <RadioButton Content="Отчет" 
                             Style="{StaticResource NavigationMenuButtonStyle}"
                             IsChecked="{Binding IsReportSelected}"/>
            </StackPanel>

            <Separator Grid.Row="1" Height="2" Background="#DADADA" Margin="3,5,3,15"/>

            <Label Grid.Row="2" Content="Тип станка:" Margin="3,3,3,0"/>
            <ComboBox Grid.Row="3" Margin="3" Height="30"
                  ItemsSource="{Binding MachineTypes}"
                  SelectedItem="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="FullName"/>

            <Label Grid.Row="4" Content="Наименование:" Margin="3,3,3,0"/>
            <ComboBox Grid.Row="5" Margin="3" Height="30"
                  ItemsSource="{Binding MachineModels}"
                  SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="FullName"/>

            <Border Grid.Row="6" Margin="3" 
                BorderThickness="1" BorderBrush="#A0A0A0" 
                Background="White" Height="220">
                <Image Source="{Binding SelectedModel.ImageName, 
                    Converter={StaticResource PathToImageConverter}}" Margin="5"/>
            </Border>

            <Border Grid.Row="7" Margin="3,5,3,3" BorderBrush="Black" BorderThickness="1" Background="White">
                <StackPanel>

                    <UniformGrid Columns="4" Margin="2">
                        <Button Style="{StaticResource IconButtonStyle}">
                            <Viewbox Width="30" Height="30">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round" 
                                          Data="M2,6 H16 A2,2 0 0 1 18,8 V16 A2,2 0 0 1 16,18 H2 A2,2 0 0 1 0,16 V8 A2,2 0 0 1 2,6 Z"/>
                                    <Path Fill="Black" Data="M18,9 L24,5 V19 L18,15 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}">
                            <Viewbox Width="28" Height="28">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M4,2 H14 L20,8 V22 H4 Z"/>
                                    <Path Stroke="Black" StrokeThickness="2" Data="M14,2 V8 H20"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M10,3 H3 V21 H10"/>
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M21,12 H9 M13,8 L9,12 L13,16"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M14,3 H21 V21 H14"/>
                                    <Path Stroke="Black" StrokeThickness="2" StrokeLineJoin="Round"
                                          Data="M3,12 H15 M11,8 L15,12 L11,16"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </UniformGrid>

                    <Separator Height="1" Background="Black" Margin="0,2"/>

                    <Grid Height="45" Background="White">
                        <TextBlock Text="{Binding SelectedModel.ClearName}" 
                                   Foreground="#D2C1B0" FontWeight="Bold" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,2,0,0"/>
                        <TextBlock Text="{Binding SelectedModel.ClearName}" 
                                   Foreground="#6B2D2D" FontWeight="Bold" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Height="1" Background="Black" Margin="0,2"/>

                    <Grid Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <UniformGrid Grid.Column="0" Columns="6" Background="#52BE94">
                            <Border BorderBrush="Black" BorderThickness="0,0,1,0">
                                <TextBlock Text="X" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="Black" BorderThickness="0,0,1,0">
                                <TextBlock Text="Y" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="Black" BorderThickness="0,0,1,0">
                                <TextBlock Text="Z" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="Black" BorderThickness="0,0,1,0">
                                <TextBlock Text="C" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="Black" BorderThickness="0,0,1,0">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border>
                                <TextBlock Text="B" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Column="1" Background="#4D66FF" BorderBrush="Black" BorderThickness="1,0,0,0">
                            <TextBlock Text="Авто" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0">
            <Border Margin="3" Background="White" BorderBrush="#A0A0A0" BorderThickness="1"
                    Visibility="{Binding IsMonitoringSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.2*"/>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Margin="3" Height="30"
                          ItemsSource="{Binding UniqueDates}"
                          SelectedItem="{Binding SelectedDate}"
                          DisplayMemberPath="DateDisplay"/>

                        <ComboBox Grid.Column="1" Margin="3" Height="30"
                          ItemsSource="{Binding AvailableTimeFrom}"
                          SelectedItem="{Binding SelectedTimeFrom}"
                          DisplayMemberPath="FullDisplay"/>

                        <ComboBox Grid.Column="2" Margin="3" Height="30"
                          ItemsSource="{Binding AvailableTimeTo}"
                          SelectedItem="{Binding SelectedTimeTo}"
                          DisplayMemberPath="FullDisplay"/>

                        <Button Grid.Column="3" Margin="3" Height="30" Padding="15,0"
                        Content="Вывод" Style="{StaticResource BlueButtonStyle}"
                        Command="{Binding LoadLineChartCommand}"/>
                    </Grid>

                    <lvc:CartesianChart Grid.Row="1" Margin="5"
                                Series="{Binding TemperatureSeries}"
                                XAxes="{Binding XAxis}"
                                YAxes="{Binding YAxis}"
                                ZoomMode="X"
                                TooltipPosition="Bottom"/>
                </Grid>
            </Border>

            <Border Margin="3" Background="White" BorderBrush="#A0A0A0" BorderThickness="1"
                    Visibility="{Binding IsHomeSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Экран: Главная" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="Gray"/>
            </Border>

            <Border Margin="3" Background="White" BorderBrush="#A0A0A0" BorderThickness="1"
                    Visibility="{Binding IsAnalysisSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Экран: Анализ" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="Gray"/>
            </Border>

            <Border Margin="3" Background="White" BorderBrush="#A0A0A0" BorderThickness="1"
                    Visibility="{Binding IsReportSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Экран: Отчеты" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="Gray"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Margin="3" Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Text="Панель справа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>